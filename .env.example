# Folioone environment template. Copy to .env.local for local work. NEVER commit real values.
#
# The database schema is always "folioone" in every environment. It is a constant in
# src/lib/db-schema.ts, not a variable here. Environments differ only by the Supabase
# project (URL + key) below. See docs/architecture/environment-variables.md.

# --- Supabase project (publishable values only; never a service-role key or DB URL) ---
# Local development / validation: the local stack (`pnpm supabase:local:start`), e.g.
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<printed by `supabase status`>
# Hosted staging (Railway variables, not a file): the existing hosted project's URL and anon key.
# Production (future): a SEPARATE project's URL and anon key.
# NEXT_PUBLIC_* values are inlined at BUILD time: set them before `pnpm build`.
# Static UI runs without Supabase configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Persona storage (server-only) ---
# fixture  : in-memory sample data (the default; no database needed)
# supabase : real persistence in schema "folioone"; use for staging and production once
#            docs/sql/folioone-schema has been executed and verified on that project.
# PERSONA_STORAGE=fixture

# --- Public site URL (optional) ---
# Origin used in email confirmation / password-reset links. Leave UNSET on Vercel Preview so each
# preview URL links back to itself; set it for a stable staging/production domain. It must be in the
# Supabase Auth redirect allow-list. See docs/architecture/m4-auth-onboarding.md.
# NEXT_PUBLIC_SITE_URL=

# --- LLM provider (server-only; never NEXT_PUBLIC_) ---
# Choose google | openai | local. Uppercase LLM_* aliases also work.
# llm_provider=local
# llm_endpoint=http://127.0.0.1:31415/v1
# llm_model=auto
# llm_api_key=                         # Optional only for an unauthenticated local gateway.
# llm_response_format=json_schema     # Or json_object for compatible gateways.
# Google: provider=google, endpoint=https://generativelanguage.googleapis.com/v1beta
# Google retains the existing gemini-3.5-flash-lite default; llm_model overrides it.
# OpenAI: provider=openai, endpoint=https://api.openai.com/v1; llm_model is required.
# Use the llm_ prefix for all settings. Endpoint is the API base, not a completion URL.
# Current feature: authenticated PDF/DOCX resume import. PDF needs model file support.
# Legacy AI_PROVIDER/AI_BASE_URL/AI_MODEL/AI_API_KEY remain local gateway fallbacks.
# GEMINI_API_KEY remains the Google key fallback; OPENAI_API_KEY is the OpenAI fallback.
# Preferred llm_* values override uppercase LLM_*, then provider-specific legacy values.
# Provider routing/retention is configured separately; Folioone does not store resumes.
# Optional MarkItDown CLI path for converting uploaded Persona documents to Markdown:
# MARKITDOWN_BIN=markitdown

# --- PRO payments via Razorpay (server-only, optional) ---
# All three are needed; leave UNSET to show "Payments coming soon" on the pricing page.
# Use test keys (rzp_test_...) until the Razorpay account is activated. USD payments also need
# International Payments enabled in the Razorpay dashboard.
# FOLIOONE_ENTITLEMENT_SECRET is printed once by docs/sql/milestone-9/002-billing-secret.sql and
# must equal folioone.billing_secrets. Never prefix any of these with NEXT_PUBLIC_.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# FOLIOONE_ENTITLEMENT_SECRET=
