# Folioone PRODUCTION environment template.
# Copy to .env.production (gitignored) or inject these non-secret settings in your
# hosting platform (Cloud Run, Vercel, Railway, etc.).
#
# Local development uses .env.local with local endpoints (127.0.0.1).
# Production fetches all server secrets from Google Cloud Secret Manager via
# src/lib/secrets/ — NEVER put real API keys or signing secrets in this file.

# --- Secret Manager (production strictly reads secrets from GCP) ---
SECRET_PROVIDER=gcp
GCP_PROJECT_ID=
SECRET_CACHE_TTL_MS=300000
# GCP Secret Manager secret name alias for the LLM API key:
GCP_SECRET_LLM_API_KEY=folio-one-llm-api-key
# On Cloud Run / GKE Workload Identity / GCE, no key file is needed (metadata server is used).
# Outside GCP, set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# or inject GCP_SERVICE_ACCOUNT_JSON via your host's secret store.

# --- Public site & Supabase project (publishable values only) ---
# Must be set before `pnpm build` (NEXT_PUBLIC_* values are inlined at build time).
NEXT_PUBLIC_SITE_URL=https://folioone.example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Persona persistence ---
# Enable supabase only after docs/sql/folioone-schema has been executed and verified.
PERSONA_STORAGE=supabase

# --- LLM non-secret provider selection (OpenRouter / OpenAI-compatible) ---
# The API key (alias: folio-one-llm-api-key) is fetched from Google Cloud Secret Manager.
# Note: llm_endpoint is the API base URL; the client appends /chat/completions.
llm_provider=openai
llm_endpoint=https://openrouter.ai/api/v1
llm_model=moonshotai/kimi-k2.6:floor
llm_response_format=json_schema

# --- Expected secrets in Google Cloud Secret Manager ---
# Create these secret names in your GCP_PROJECT_ID project:
#   - folio-one-llm-api-key (mapped via GCP_SECRET_LLM_API_KEY)
#   - RAZORPAY_KEY_ID
#   - RAZORPAY_KEY_SECRET
#   - FOLIOONE_ENTITLEMENT_SECRET
